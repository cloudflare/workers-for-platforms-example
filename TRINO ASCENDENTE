"use client";

import { useState, useEffect, useCallback } from 'react';
import { useRouter } from 'next/navigation';
import { handleAscension as ascensionAction } from '@/app/actions';

interface TrinoAscendenteProps {
  autoTrigger?: boolean;
  onComplete?: (result: any) => void;
}

export default function TrinoAscendente({ 
  autoTrigger = false,
  onComplete 
}: TrinoAscendenteProps) {
  const [state, setState] = useState({
    isAscending: false,
    result: null as any,
    error: null as string | null,
    progress: 0,
  });
  
  const router = useRouter();
  
  // Handler seguro para ascensión
  const triggerAscension = useCallback(async () => {
    // Evitar múltiples ejecuciones
    if (state.isAscending) return;
    
    setState(prev => ({ ...prev, isAscending: true, error: null, progress: 10 }));
    
    try {
      // Simular progreso
      const progressInterval = setInterval(() => {
        setState(prev => ({
          ...prev,
          progress: Math.min(prev.progress + 10, 90)
        }));
      }, 300);
      
      // ✅ Llamada SEGURA a la acción
      const result = await ascensionAction();
      
      clearInterval(progressInterval);
      
      setState(prev => ({
        ...prev,
        isAscending: false,
        result,
        progress: 100,
      }));
      
      // Callback si existe
      if (onComplete) {
        onComplete(result);
      }
      
      // Redirección condicional (si es necesaria)
      if (result?.requiresRedirect) {
        // Usar setTimeout para separar del ciclo de render actual
        setTimeout(() => {
          router.push('/ascension-complete');
        }, 100);
      }
      
      // Reset después de 2 segundos
      setTimeout(() => {
        setState(prev => ({ ...prev, progress: 0 }));
      }, 2000);
      
    } catch (error) {
      setState(prev => ({
        ...prev,
        isAscending: false,
        error: error instanceof Error ? error.message : 'Error desconocido',
        progress: 0,
      }));
    }
  }, [state.isAscending, router, onComplete]);
  
  // Auto-trigger solo si es necesario
  useEffect(() => {
    if (autoTrigger && !state.isAscending && !state.result) {
      // Retrasar ligeramente para asegurar que el componente esté montado
      const timer = setTimeout(() => {
        triggerAscension();
      }, 100);
      
      return () => clearTimeout(timer);
    }
  }, [autoTrigger, triggerAscension, state.isAscending, state.result]);
  
  return (
    <div className="p-6 bg-gradient-to-br from-purple-900 to-blue-900 rounded-xl">
      <h2 className="text-2xl font-bold mb-4 text-white">
        Trino Ascendente
      </h2>
      
      <button
        onClick={triggerAscension}
        disabled={state.isAscending}
        className={`px-6 py-3 rounded-lg font-semibold transition-all ${
          state.isAscending
            ? 'bg-gray-600 cursor-not-allowed'
            : 'bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700'
        } text-white`}
      >
        {state.isAscending ? (
          <span className="flex items-center gap-2">
            <span className="animate-spin">🌀</span>
            Ascendiendo... {state.progress}%
          </span>
        ) : (
          'Activar Ascensión Trina'
        )}
      </button>
      
      {state.error && (
        <div className="mt-4 p-3 bg-red-900/50 border border-red-700 rounded">
          <p className="text-red-200">Error: {state.error}</p>
        </div>
      )}
      
      {state.result && (
        <div className="mt-4 p-4 bg-green-900/30 border border-green-600 rounded">
          <h3 className="text-green-300 font-bold">¡Ascensión Completada!</h3>
          <pre className="text-sm text-gray-200 mt-2">
            {JSON.stringify(state.result, null, 2)}
          </pre>
        </div>
      )}
    </div>
  );
}


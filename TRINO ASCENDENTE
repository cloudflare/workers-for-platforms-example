import { useState, useCallback } from 'react';
import { useRouter } from 'next/navigation';

export function useAscension() {
  const [state, setState] = useState({
    loading: false,
    error: null as string | null,
    data: null as any,
  });
  
  const router = useRouter();
  
  const executeAscension = useCallback(async (options = {}) => {
    if (state.loading) return;
    
    setState({ loading: true, error: null, data: null });
    
    try {
      // Simular una llamada segura
      await new Promise(resolve => setTimeout(resolve, 1000));
      
      const result = {
        success: true,
        message: 'Ascensión trina completada',
        timestamp: new Date().toISOString(),
        level: 12,
      };
      
      setState({ loading: false, error: null, data: result });
      
      // Manejar redirección si es necesario
      if (options.redirectTo) {
        // Usar un microtask para redirigir
        Promise.resolve().then(() => {
          router.push(options.redirectTo);
        });
      }
      
      return result;
    } catch (error) {
      const errorMsg = error instanceof Error ? error.message : 'Error en ascensión';
      setState({ loading: false, error: errorMsg, data: null });
      throw error;
    }
  }, [state.loading, router]);
  
  return {
    ...state,
    executeAscension,
  };
}

